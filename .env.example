# Rails
RAILS_ENV=development
APP_HOST=localhost
MAILER_FROM=PeerGem <noreply@example.com>

# PostgreSQL
DATABASE_PASSWORD=peergem

# Redis / Sidekiq / Redlock / Stoplight
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5
RACK_ATTACK_THROTTLE_SECRET=

# AWS SES v2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=peergem-production

# Local object storage
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=peergem-development

# MaxMind GeoIP2
GEOIP_DATABASE_PATH=vendor/geoip/GeoLite2-City.mmdb

# AvaTax
AVATAX_ENDPOINT=https://sandbox-rest.avatax.com
AVATAX_USERNAME=
AVATAX_PASSWORD=

# Operations
SENTRY_DSN=
HEALTHCHECK_USERNAME=
HEALTHCHECK_PASSWORD=
